{
  "name": "lift-pass-pricing",
  "version": "1.0.0",
  "description": "Lift-Pass-Pricing refactoring kata",
  "main": "index.ts",
  "scripts": {
    "start": "ts-node index.ts",
    "test": "mocha --require ts-node/register --require test/setup.ts --timeout 10000 \"test/**/*.spec.ts\"",
    "test:unit": "mocha --require ts-node/register --require test/setup.ts \"test/unit/**/*.spec.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov --include=src npm test",
    "compile": "tsc",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "sonar:up": "docker compose --profile analise up -d sonarqube",
    "sonar:scan": "docker compose --profile analise --profile scan run --rm scanner"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^4.17.1",
    "mysql2": "^2.3.3"
  },
  "devDependencies": {
    "@types/chai": "^4.1.7",
    "@types/express": "^4.17.1",
    "@types/mocha": "^5.2.6",
    "@types/node": "16.18.68",
    "@types/supertest": "^2.0.7",
    "c8": "^10.1.3",
    "chai": "^4.2.0",
    "mocha": "^6.1.2",
    "supertest": "^4.0.2",
    "ts-node": "^8.0.3",
    "typescript": "^4.8.4"
  }
}
