{
  "name": "lift-pass-pricing",
  "version": "1.0.0",
  "description": "API de preço de passe de esqui (kata Lift Pass Pricing) refatorada para a disciplina de Manutenção e Melhoria de Software",
  "main": "index.ts",
  "scripts": {
    "start": "ts-node index.ts",
    "demo": "ts-node scripts/demo.ts",
    "test": "mocha --require ts-node/register --require test/setup.ts --timeout 10000 \"test/**/*.spec.ts\"",
    "test:unit": "mocha --require ts-node/register --require test/setup.ts \"test/unit/**/*.spec.ts\"",
    "test:coverage": "c8 npm test",
    "lint": "eslint .",
    "lint:legado": "node scripts/lint-legado.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck && npm run test:coverage",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "sonar:up": "docker compose --profile analise up -d sonarqube",
    "sonar:scan": "node scripts/normalizar-lcov.mjs && docker compose --profile analise --profile scan run --rm scanner"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.3",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^4.3.20",
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22"
  }
}
